# AI Token Gateway 环境配置

# 后端配置
PORT=3000
NODE_ENV=development

# 数据库 (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/ai_token_gateway?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT 配置
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# API Key 配置
API_KEY_PREFIX="sk-aitoken"

# AI 提供商 API Keys (必须配置)
OPENAI_API_KEY="sk-your-openai-api-key"
ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key"
GEMINI_API_KEY="your-gemini-api-key"

# 前端配置
VITE_API_BASE_URL="http://localhost:3000"

# Docker 环境变量
POSTGRES_USER="aiuser"
POSTGRES_PASSWORD="aipassword"
POSTGRES_DB="ai_token_gateway"
